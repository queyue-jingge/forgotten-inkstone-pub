+    按空白切分；成对的 " 把含空格的片段括成一项且引号本身去掉；
+    反斜杠不作转义（Windows 路径里的反斜杠原样保留，也不给空格转义）；
+    引号不配对 → ConfigError。
+    """
+    tokens = []
+    cur = []
+    started = False
+    in_quote = False
+    for ch in s:
+        if ch == '"':
+            in_quote = not in_quote
+            started = True
+        elif ch.isspace() and not in_quote:
+            if started:
+                tokens.append("".join(cur))
+                cur = []
+                started = False
+        else:
+            cur.append(ch)
+            started = True
+    if in_quote:
+        raise ConfigError(f"TEACH_CLAUDE_ARGS 里的引号不配对：{s}")
+    if started:
+        tokens.append("".join(cur))
+    return tokens
