+class AgentArgvConfig(unittest.TestCase):
+    def test_empty_raw_args_means_no_flags(self):
+        self.assertEqual(driver.agent_argv("PROMPT", None, bin_name="x", raw_args=""), [])
+        self.assertEqual(
+            driver.agent_argv("PROMPT", "s1", bin_name="x", raw_args="",
+                              resume_flag="--resume"), [])
+
+    def test_none_raw_args_reads_module_config(self):
+        expected = driver.agent_argv("PROMPT", "s1", bin_name="x",
+                                     raw_args=driver.RAW_ARGS, resume_flag="--resume")
+        self.assertEqual(
+            driver.agent_argv("PROMPT", "s1", bin_name="x", raw_args=None,
+                              resume_flag="--resume"), expected)
+
+    def test_explicit_kwargs_never_read_env(self):
+        keys = ("TEACH_CLAUDE_BIN", "TEACH_CLAUDE_ARGS", "TEACH_CLAUDE_RESUME_FLAG")
+        keep = {k: os.environ.get(k) for k in keys}
+        raw_args_before, resume_flag_before = driver.RAW_ARGS, driver.RESUME_FLAG
+        try:
+            os.environ["TEACH_CLAUDE_BIN"] = "poisoned bin"
+            os.environ["TEACH_CLAUDE_ARGS"] = "--poisoned"
+            os.environ["TEACH_CLAUDE_RESUME_FLAG"] = "--poisoned-resume"
+            got = driver.agent_argv("P", "s1", bin_name="x",
+                                    raw_args="--a {session} {resume}", resume_flag="--r")
+        finally:
+            for k, v in keep.items():
+                if v is None:
+                    os.environ.pop(k, None)
+                else:
+                    os.environ[k] = v
+        self.assertEqual(got, ["--a", "s1", "--r", "s1"])
+        self.assertEqual(driver.RAW_ARGS, raw_args_before)
+        self.assertEqual(driver.RESUME_FLAG, resume_flag_before)
+
+    def test_bin_with_space_warns_once_but_is_not_fatal(self):
+        # 老式「整条命令」写法：不抛异常，只告警一次（提示把 flag 挪去 TEACH_CLAUDE_ARGS）
+        seen = []
+        old_log = driver.log
+        driver.log = seen.append
+        try:
+            driver._WARNED.clear()
+            got = driver.agent_argv("PROMPT", None,
+                                    bin_name="claude --dangerously-skip-permissions",
+                                    raw_args="")
+            driver.agent_argv("PROMPT", None,
+                              bin_name="claude --dangerously-skip-permissions", raw_args="")
+        finally:
+            driver.log = old_log
+        self.assertEqual(got, [])
+        self.assertEqual(len(seen), 1)
+
