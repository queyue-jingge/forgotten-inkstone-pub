+#!/usr/bin/env python3
+"""driver.py 的 agent 配置层单测：只用标准库。
+
+跑：python3 -m unittest discover -s tests
+"""
+import ast
+import os
+import sys
+import unittest
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, REPO)
+
+import driver
+
+# 改动前 driver.py 里写死的那串 flag（回归锁定用）
+LEGACY_FLAGS = ["-p", "--input-format", "stream-json", "--output-format", "stream-json",
+                "--verbose", "--dangerously-skip-permissions",
+                "--append-system-prompt"]
+
+
+class DefaultsRegression(unittest.TestCase):
+    """默认配置展开出来必须跟改动前的硬编码 argv 逐 token 一致。"""
+
+    def test_default_template_no_sid(self):
+        got = driver.agent_argv("PROMPT", None, bin_name="agent",
+                                raw_args=driver.DEFAULT_ARGS, resume_flag="--resume")
+        self.assertEqual(got, LEGACY_FLAGS + ["PROMPT"])
+
+    def test_default_template_with_sid(self):
+        got = driver.agent_argv("PROMPT", "abc", bin_name="agent",
+                                raw_args=driver.DEFAULT_ARGS, resume_flag="--resume")
+        self.assertEqual(got, LEGACY_FLAGS + ["PROMPT", "--resume", "abc"])
+
+    def test_program_token_is_resolved_or_raw(self):
+        # 完整 argv = [解析出来的可执行文件 or 原始名] + agent_argv(...)
+        self.assertEqual([driver.AGENT_BIN or driver.RAW_BIN] + ["-p"],
+                         [driver.AGENT_BIN or driver.RAW_BIN, "-p"])
+        self.assertTrue(driver.AGENT_BIN is None or os.path.isabs(driver.AGENT_BIN))
+
+    @unittest.skipIf(os.environ.get("TEACH_CLAUDE_ARGS") is not None,
+                     "TEACH_CLAUDE_ARGS 被显式设置了")
+    def test_module_raw_args_defaults_to_template(self):
+        self.assertEqual(driver.RAW_ARGS, driver.DEFAULT_ARGS)
+
+    @unittest.skipIf(os.environ.get("TEACH_CLAUDE_BIN") is not None,
+                     "TEACH_CLAUDE_BIN 被显式设置了")
+    def test_module_raw_bin_defaults_to_claude(self):
+        self.assertEqual(driver.RAW_BIN, "claude")
+
+    @unittest.skipIf(os.environ.get("TEACH_CLAUDE_RESUME_FLAG") is not None,
+                     "TEACH_CLAUDE_RESUME_FLAG 被显式设置了")
+    def test_module_resume_flag_default(self):
+        self.assertEqual(driver.RESUME_FLAG, "--resume")
+
+    def test_default_template_tokens_are_legacy_tokens(self):
+        self.assertEqual(driver.split_args(driver.DEFAULT_ARGS),
+                         LEGACY_FLAGS + ["{prompt}", "{resume}"])
+
+
+class SplitArgs(unittest.TestCase):
+    def test_whitespace_and_newlines(self):
+        self.assertEqual(driver.split_args("  -a\t-b\n -c  "), ["-a", "-b", "-c"])
+
+    def test_quoted_group_keeps_spaces(self):
+        self.assertEqual(driver.split_args('-x "a b" -y'), ["-x", "a b", "-y"])
+
+    def test_quotes_stripped_mid_token(self):
+        self.assertEqual(driver.split_args('--p="a b"'), ["--p=a b"])
+
+    def test_backslash_not_an_escape(self):
+        bs = chr(92)
+        raw = "C:" + bs + "Users" + bs + "x" + bs + "y.json"
+        self.assertEqual(driver.split_args(raw), [raw])
+        self.assertEqual(driver.split_args('"a ' + bs + ' b"'), ["a " + bs + " b"])
+
+    def test_empty(self):
+        self.assertEqual(driver.split_args(""), [])
+        self.assertEqual(driver.split_args("   \n\t "), [])
+
+    def test_empty_quoted_token(self):
+        self.assertEqual(driver.split_args('-x ""'), ["-x", ""])
+
+    def test_unbalanced_quote_raises(self):
+        with self.assertRaises(driver.ConfigError):
+            driver.split_args('--x "unclosed')
+        with self.assertRaises(driver.ConfigError):
+            driver.split_args('--x "unclosed ')
+
+
+class ExpandArgs(unittest.TestCase):
+    def _expand(self, tokens, **kw):
+        kw.setdefault("prompt", "PROMPT")
+        kw.setdefault("prompt_file", "/abs/prompts/白砚.md")
+        kw.setdefault("session", "")
+        kw.setdefault("resume_flag", "--resume")
+        return driver.expand_args(tokens, **kw)
+
+    def test_prompt_and_prompt_file(self):
+        self.assertEqual(self._expand(["{prompt}", "{prompt_file}"]),
+                         ["PROMPT", "/abs/prompts/白砚.md"])
+
+    def test_session_placeholder(self):
+        self.assertEqual(self._expand(["--id", "{session}"], session="s1"), ["--id", "s1"])
+        self.assertEqual(self._expand(["--id", "{session}"]), ["--id", ""])
+
+    def test_resume_placeholder_with_session_is_two_tokens(self):
+        self.assertEqual(self._expand(["{resume}"], session="abc"), ["--resume", "abc"])
+
+    def test_resume_placeholder_without_session_is_zero_tokens(self):
+        self.assertEqual(self._expand(["-p", "{resume}", "-v"]), ["-p", "-v"])
+
+    def test_custom_resume_flag(self):
+        self.assertEqual(self._expand(["{resume}"], session="abc", resume_flag="--continue"),
+                         ["--continue", "abc"])
+
+    def test_unknown_placeholder_kept_verbatim(self):
+        self.assertEqual(self._expand(["--x", "{foo}", "{prompt}bar", "{ }"]),
+                         ["--x", "{foo}", "{prompt}bar", "{ }"])
+
