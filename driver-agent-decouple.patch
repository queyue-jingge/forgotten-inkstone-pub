+class NoHardcodedClaudeFlags(unittest.TestCase):
+    """driver.py 里不许再出现 Claude 专有参数（只能躺在 DEFAULT_ARGS 模板里）。"""
+
+    def _source_without_docstring(self):
+        with open(os.path.join(REPO, "driver.py"), encoding="utf-8") as f:
+            src = f.read()
+        tree = ast.parse(src)
+        head = tree.body[0] if tree.body else None
+        doc = (head.value.value
+               if isinstance(head, ast.Expr) and isinstance(head.value, ast.Constant)
+               and isinstance(head.value.value, str) else "")
+        return src.replace(doc, "", 1) if doc else src
+
+    def test_flags_only_live_in_default_template(self):
+        src = self._source_without_docstring()
+        for flag in ("--input-format", "--output-format", "--verbose",
+                     "--dangerously-skip-permissions", "--append-system-prompt",
+                     "--resume"):
+            self.assertEqual(src.count(flag), 1,
+                             f"{flag} 在 driver.py 里出现 {src.count(flag)} 次，应为 1 次")
+
+    def test_no_claude_bin_constant_left(self):
+        with open(os.path.join(REPO, "driver.py"), encoding="utf-8") as f:
+            src = f.read()
+        self.assertNotIn("CLAUDE_BIN =", src)
+
+
+if __name__ == "__main__":
+    unittest.main()
