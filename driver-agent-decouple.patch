+            out.append(prompt)
+        elif tok == "{prompt_file}":
+            out.append(prompt_file)
+        elif tok == "{session}":
+            out.append(session or "")
+        elif tok == "{resume}":
+            if session:
+                out.extend([resume_flag, session])
+        else:
+            out.append(tok)
+    return out
